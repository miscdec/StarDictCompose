<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x30"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_wordSnackbar_word"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wonder"
                android:textSize="@dimen/x60" />

            <TextView
                android:id="@+id/tv_wordSnackbar_phonetic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/x50"
                android:layout_marginTop="@dimen/x5"
                android:text="/&apos;æR1ɪuə/"
                android:textSize="@dimen/x38" />

            <ImageView
                android:id="@+id/img_wordSnackbar_sound"
                android:layout_width="@dimen/x80"
                android:layout_height="@dimen/x80"
                android:layout_marginLeft="@dimen/x30"
                android:layout_marginTop="@dimen/x5"
                android:background="@drawable/item_bg_white"
                android:clickable="true"
                android:padding="@dimen/x10"
                android:scaleType="centerInside"
                android:src="@drawable/ic_sound" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_wordSnackbar_expCN"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/x20"
            android:layout_marginRight="@dimen/x200"
            android:layout_marginBottom="@dimen/x30"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:lineSpacingExtra="@dimen/x30"
            android:lines="2"
            android:maxLines="2" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_wordSnackbar_btn"
        android:layout_width="@dimen/x160"
        android:layout_height="@dimen/x100"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:gravity="center"
        android:text="详情"
        android:textSize="@dimen/x45" />
</RelativeLayout>
