<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x140"
        android:layout_marginTop="@dimen/x25"
        android:layout_marginBottom="@dimen/x25">

        <ImageView
            android:id="@+id/img_share_wechat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="@dimen/x15"
            android:src="@drawable/img_wechat" />

        <ImageView
            android:id="@+id/img_share_friends"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="@dimen/x15"
            android:src="@drawable/img_wechat_friends" />

        <ImageView
            android:id="@+id/img_share_qq"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="@dimen/x15"
            android:src="@drawable/img_qq" />

        <ImageView
            android:id="@+id/img_share_qzone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="@dimen/x15"
            android:src="@drawable/img_qzone" />

        <ImageView
            android:id="@+id/img_share_weibo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="@dimen/x15"
            android:src="@drawable/img_weibo" />
    </LinearLayout>
</RelativeLayout>
