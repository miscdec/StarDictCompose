<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/x200"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x40"
        android:layout_marginTop="@dimen/x60"
        android:layout_marginBottom="@dimen/x30"
        android:text="其他"
        android:textColor="@color/red_datong"
        android:textSize="@dimen/x45" />

    <RelativeLayout
        android:id="@+id/relat_setting_other_clearSearchHistory"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x150"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x40"
            android:text="清空历史搜索记录"
            android:textSize="@dimen/x40" />

        <TextView
            android:id="@+id/tv_setting_other_searchHistoryCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/x40"
            android:text="12"
            android:textColor="#000000"
            android:textSize="@dimen/x45" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/relat_setting_other_clearTranslateHistory"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x150"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x40"
            android:text="清空历史翻译记录"
            android:textSize="@dimen/x40" />

        <TextView
            android:id="@+id/tv_setting_other_translateHistoryCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/x40"
            android:text="12"
            android:textColor="#000000"
            android:textSize="@dimen/x45" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/relat_setting_other_clearCache"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x150"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x40"
            android:text="清除缓存"
            android:textSize="@dimen/x40" />

        <TextView
            android:id="@+id/tv_setting_other_cacheSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/x40"
            android:text="0M"
            android:textColor="#000000"
            android:textSize="@dimen/x45" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/relat_setting_other_betaPush"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x180"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x40"
            android:layout_marginTop="@dimen/x30"
            android:lineSpacingExtra="@dimen/x20"
            android:text="接收测试版推送"
            android:textSize="@dimen/x40" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginLeft="@dimen/x40"
            android:layout_marginBottom="@dimen/x30"
            android:text="接收测试版推送，第一时间体验新功能"
            android:textColor="@color/gray"
            android:textSize="@dimen/x35" />

        <Switch
            android:id="@+id/switch_setting_other_betaPush"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/x15"
            android:theme="@style/MySwitch" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/relat_setting_other_chechUpdate"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x150"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x40"
            android:text="检查更新"
            android:textSize="@dimen/x40" />

        <TextView
            android:id="@+id/tv_setting_other_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/x40"
            android:text="v1.7.5"
            android:textColor="#000000"
            android:textSize="@dimen/x45" />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x150"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x40"
            android:text="给个好评"
            android:textSize="@dimen/x40" />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x150"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x40"
            android:text="关于"
            android:textSize="@dimen/x40" />
    </RelativeLayout>
</LinearLayout>
