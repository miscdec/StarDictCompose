<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/linear_notification_view_contentView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/x30"
    android:background="#ffffff"
    android:clickable="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_notification_view_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x40"
        android:layout_marginTop="@dimen/x20"
        android:maxLines="1"
        android:singleLine="true"
        android:text="春节特惠活动火爆进行中"
        android:textSize="@dimen/x48"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_notification_view_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x40"
        android:layout_marginTop="@dimen/x10"
        android:layout_marginRight="@dimen/x40"
        android:lineSpacingExtra="@dimen/x5"
        android:text="原价39.99元的终身版Pro会员，现在半价出售啦，数量有限，先到先得哟~！"
        android:textSize="@dimen/x42" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/x40"
        android:layout_marginBottom="@dimen/x40">

        <TextView
            android:id="@+id/tv_notification_view_btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/x40"
            android:background="@drawable/shape_outline_01"
            android:padding="@dimen/x20"
            android:text="以后再说"
            android:textColor="#000000"
            android:textSize="@dimen/x35" />

        <TextView
            android:id="@+id/tv_notification_view_btnOk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/x40"
            android:background="@drawable/shape_outline_01"
            android:padding="@dimen/x20"
            android:text="参与"
            android:textColor="#000000"
            android:textSize="@dimen/x35" />
    </LinearLayout>
</LinearLayout>
