<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/relat_item_list_personal_rootView"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x180"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true">

    <TextView
        android:id="@+id/tv_item_list_personal_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginLeft="@dimen/x40"
        android:text="用户名"
        android:textSize="@dimen/x40" />

    <TextView
        android:id="@+id/tv_item_list_personal_subTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="@dimen/x40"
        android:text="Luo Jieer"
        android:textColor="#000000"
        android:textSize="@dimen/x45" />

    <ImageView
        android:id="@+id/img_item_list_personal_icon"
        android:layout_width="@dimen/x100"
        android:layout_height="@dimen/x100"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="@dimen/x27"
        android:scaleType="centerInside"
        android:visibility="gone" />
</RelativeLayout>
