<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_messageDialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x70"
        android:layout_marginTop="@dimen/x70"
        android:layout_marginRight="@dimen/x70"
        android:text="Title"
        android:textSize="@dimen/x52"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_messageDialog_title"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_messageDialog_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x70"
            android:layout_marginTop="@dimen/x20"
            android:layout_marginRight="@dimen/x70"
            android:lineSpacingExtra="@dimen/x5"
            android:text="content"
            android:textColor="#000000"
            android:textSize="@dimen/x49" />

        <CheckBox
            android:id="@+id/cb_messageDialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x50"
            android:layout_marginTop="@dimen/y20"
            android:textColor="#000000"
            android:textSize="@dimen/y44"
            android:theme="@style/MyUIStyle"
            android:visibility="gone" />
    </LinearLayout>
</RelativeLayout>
