<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/relat_item_list_rootView"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x180">

    <LinearLayout
        android:id="@+id/linear_item_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/item_bg_gary"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/img_item_list_home_menu"
            android:layout_width="@dimen/x90"
            android:layout_height="@dimen/x90"
            android:layout_marginLeft="@dimen/x80"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/tv_item_list_home_menu_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x60"
            android:text="Launchpad"
            android:textColor="#000000"
            android:textSize="@dimen/x40" />
    </LinearLayout>

    <View
        android:id="@+id/view_item_list_home_menu_seletor"
        android:layout_width="@dimen/x8"
        android:layout_height="match_parent"
        android:background="@color/red_datong" />
</RelativeLayout>
