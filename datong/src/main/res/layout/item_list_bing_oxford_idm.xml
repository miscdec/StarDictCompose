<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/x30"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_item_list_bing_oxford_idm_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#000000"
        android:paddingLeft="@dimen/x20"
        android:paddingTop="@dimen/x10"
        android:paddingRight="@dimen/x20"
        android:paddingBottom="@dimen/x10"
        android:text="IDM"
        android:textColor="#ffffff"
        android:textSize="@dimen/x35"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_item_list_bing_oxford_idm_phrase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x30"
        android:lineSpacingExtra="@dimen/x10"
        android:text="do wonders (for sb/sth)"
        android:textColor="#000000"
        android:textSize="@dimen/x45"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_item_list_bing_oxford_idm_expCN"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x10"
        android:lineSpacingExtra="@dimen/x10"
        android:text="不足为奇；并不奇怪"
        android:textColor="#000000"
        android:textSize="@dimen/x45" />

    <com.datong.dict.widget.WordTextView
        android:id="@+id/tv_item_list_bing_oxford_idm_expEN"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x5"
        android:lineSpacingExtra="@dimen/x10"
        android:text="it is not surprising"
        android:textColor="#000000"
        android:textSize="@dimen/x45" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list_item_list_bing_oxford_idm_sentence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x10"
        android:scrollbars="none" />
</LinearLayout>
