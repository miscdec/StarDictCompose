<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/x20">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/x25"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_item_list_datong_jp_expJC_sentence_jp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginRight="@dimen/x100"
                android:lineSpacingExtra="@dimen/x10"
                android:text="子供のころはこのへんでよくあそんだっけ"
                android:textSize="@dimen/x40" />

            <ImageView
                android:id="@+id/img_item_list_datong_jp_expJC_sentence_sound"
                android:layout_width="@dimen/x80"
                android:layout_height="@dimen/x80"
                android:layout_alignParentRight="true"
                android:background="@drawable/item_bg_gary"
                android:clickable="true"
                android:padding="@dimen/x10"
                android:scaleType="centerInside"
                android:src="@drawable/ic_sound" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tv_item_list_datong_jp_expJC_sentence_cn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/x100"
            android:lineSpacingExtra="@dimen/x10"
            android:text="童年时常在这一带玩。"
            android:textSize="@dimen/x40" />
    </LinearLayout>
</LinearLayout>
