<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="#ffffff" android:layout_width="match_parent" android:layout_height="match_parent">
    <include layout="@layout/statusbar"/>
    <include layout="@layout/toolbar"/>
    <RelativeLayout android:id="@+id/relate_translate_language" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:layout_below="@+id/toolbar">
        <ImageView android:id="@+id/img_translate_exchange" android:padding="@dimen/x35" android:layout_width="@dimen/x200" android:layout_height="@dimen/x150" android:src="@drawable/ic_exchange" android:scaleType="centerInside" android:layout_centerInParent="true"/>
        <LinearLayout android:gravity="center" android:id="@+id/linear_translate_from" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/x150" android:layout_centerVertical="true">
            <TextView android:textSize="@dimen/x48" android:textColor="#000000" android:id="@+id/tv_translate_languageFrom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="中文"/>
            <ImageView android:layout_width="@dimen/x80" android:layout_height="@dimen/x80" android:src="@drawable/ic_drop_black" android:layout_centerInParent="true"/>
        </LinearLayout>
        <LinearLayout android:gravity="center" android:id="@+id/linear_translate_to" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="@dimen/x100" android:layout_alignParentRight="true" android:layout_centerVertical="true">
            <TextView android:textSize="@dimen/x48" android:textColor="#000000" android:id="@+id/tv_translate_languageTo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="日语"/>
            <ImageView android:layout_width="@dimen/x80" android:layout_height="@dimen/x80" android:src="@drawable/ic_drop_black" android:layout_centerInParent="true"/>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout android:orientation="vertical" android:id="@+id/relate_translate_content" android:background="#f9f9f9" android:layout_width="match_parent" android:layout_height="@dimen/x550" android:layout_below="@+id/relate_translate_language">
        <EditText android:theme="@style/MyUIStyle" android:textSize="@dimen/x48" android:textColor="@color/gray_dark" android:gravity="left" android:id="@+id/et_translate_content" android:background="#f9f9f9" android:paddingLeft="@dimen/x50" android:paddingTop="@dimen/x25" android:paddingRight="@dimen/x25" android:scrollbars="vertical" android:layout_width="match_parent" android:layout_height="@dimen/x450" android:hint="请输入要翻译的文本" android:lineSpacingExtra="@dimen/x5"/>
        <RelativeLayout android:layout_width="match_parent" android:layout_height="@dimen/x100" android:layout_alignParentBottom="true">
            <TextView android:textSize="@dimen/x42" android:textColor="#000000" android:id="@+id/tv_translate_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/x50" android:text="0" android:layout_centerVertical="true"/>
            <ImageView android:id="@+id/img_translate_translate" android:background="@drawable/item_bg_gary" android:padding="@dimen/x10" android:clickable="true" android:layout_width="@dimen/x80" android:layout_height="@dimen/x80" android:layout_marginRight="@dimen/x30" android:src="@drawable/ic_send_black" android:layout_alignParentRight="true" android:layout_centerVertical="true"/>
            <ImageView android:id="@+id/img_translate_clear" android:background="@drawable/item_bg_gary" android:padding="@dimen/x10" android:clickable="true" android:layout_width="@dimen/x80" android:layout_height="@dimen/x80" android:layout_marginRight="@dimen/x140" android:src="@drawable/ic_close_block" android:layout_alignParentRight="true" android:layout_centerVertical="true"/>
            <ImageView android:id="@+id/img_translate_voice" android:background="@drawable/item_bg_gary" android:padding="@dimen/x10" android:visibility="gone" android:clickable="true" android:layout_width="@dimen/x80" android:layout_height="@dimen/x80" android:layout_marginRight="@dimen/x240" android:src="@drawable/ic_voice_black" android:layout_alignParentRight="true" android:layout_centerVertical="true"/>
            <ImageView android:id="@+id/img_translate_camera" android:background="@drawable/item_bg_gary" android:padding="@dimen/x10" android:visibility="gone" android:clickable="true" android:layout_width="@dimen/x80" android:layout_height="@dimen/x80" android:layout_marginRight="@dimen/x350" android:src="@drawable/ic_camera_black" android:layout_alignParentRight="true" android:layout_centerVertical="true"/>
        </RelativeLayout>
    </RelativeLayout>
    <com.datong.dict.widget.base.BaseRecyclerView android:id="@+id/list_translate_history" android:scrollbars="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@+id/relate_translate_content" android:overScrollMode="never"/>
    <RelativeLayout android:id="@+id/relate_translate_result" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@+id/relate_translate_content">
        <com.datong.dict.widget.base.BaseRecyclerView android:id="@+id/list_translate_result" android:paddingLeft="@dimen/x50" android:paddingTop="@dimen/x50" android:paddingBottom="@dimen/x50" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never"/>
        <com.datong.dict.widget.base.BaseRecyclerView android:id="@+id/list_translate_selector" android:layout_width="wrap_content" android:layout_height="@dimen/x100" android:layout_marginBottom="@dimen/x35" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true" android:overScrollMode="never"/>
    </RelativeLayout>
    <androidx.coordinatorlayout.widget.CoordinatorLayout android:id="@+id/coord_translate" android:layout_width="match_parent" android:layout_height="match_parent">
        <com.google.android.material.floatingactionbutton.FloatingActionButton android:theme="@style/MyUIStyle" android:layout_gravity="bottom|right" android:id="@+id/fab_book_addBook" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="@dimen/x50" android:layout_marginBottom="@dimen/x50" android:src="@drawable/ic_all_inclusiv"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</RelativeLayout>
