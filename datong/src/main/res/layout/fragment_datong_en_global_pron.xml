<?xml version="1.0" encoding="utf-8"?>
<com.datong.dict.widget.base.BaseScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="always"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:descendantFocusability="blocksDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:paddingLeft="@dimen/x20"
        android:paddingRight="@dimen/x20"
        android:paddingBottom="@dimen/x20">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_datong_global_pron"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x20">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_datong_global_pron_word"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/x50"
                    android:layout_marginTop="@dimen/x30"
                    android:text="wonder"
                    android:textColor="@color/red_datong"
                    android:textSize="@dimen/x60"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list_datong_global_pron"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/x10" />

                <ImageView
                    android:layout_width="@dimen/x200"
                    android:layout_height="@dimen/x100"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginTop="@dimen/x20"
                    android:layout_marginBottom="@dimen/x20"
                    android:scaleType="centerInside"
                    android:src="@drawable/img_forvo_logo" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</com.datong.dict.widget.base.BaseScrollView>
