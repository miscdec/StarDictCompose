<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/x20"
    android:layout_marginRight="@dimen/x20"
    app:contentPaddingLeft="@dimen/x50">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:id="@+id/item_list_header"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x50" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_item_list_ciba_collins_index"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1."
                android:textSize="@dimen/x45"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/x30"
                android:layout_marginRight="@dimen/x60"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_item_list_ciba_collins_expCN"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="@dimen/x10"
                    android:text="[t][i]想知道；想弄明白；琢磨"
                    android:textColor="#000000"
                    android:textSize="@dimen/x45" />

                <com.datong.dict.widget.WordTextView
                    android:id="@+id/tv_item_list_ciba_collins_expEN"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/x5"
                    android:lineSpacingExtra="@dimen/x10"
                    android:text="toLanguage think about sth and try toLanguage decide what is true, what will happen, what you should do, etc."
                    android:textColor="#000000"
                    android:textSize="@dimen/x45" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list_item_list_ciba_collins_sentence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/x10"
                    android:scrollbars="none" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/item_list_footer"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x50" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
