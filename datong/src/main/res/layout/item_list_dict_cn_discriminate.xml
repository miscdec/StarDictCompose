<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/x20"
    android:layout_marginRight="@dimen/x20"
    app:contentPaddingLeft="@dimen/x60">

    <LinearLayout
        android:id="@+id/linear_item_list_rootView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x50"
        android:layout_marginBottom="@dimen/x50">

        <TextView
            android:id="@+id/tv_item_list_dictCn_discriminate_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x3"
            android:text="1."
            android:textSize="@dimen/x45"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x30"
            android:layout_marginRight="@dimen/x60"
            android:orientation="vertical">

            <com.datong.dict.widget.WordTextView
                android:id="@+id/tv_item_list_dictCn_discriminate_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="@dimen/x10"
                android:text="wonder about, wonder at"
                android:textColor="#000000"
                android:textSize="@dimen/x50"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_item_list_dictCn_discriminate_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x20"
                android:lineSpacingExtra="@dimen/x20"
                android:text="当wonder与whether〔if〕连用时,表示“思考某事,并设法判断该事是否属实”,也可表示一种委婉的请求或邀请。"
                android:textColor="#000000"
                android:textSize="@dimen/x40" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
