<?xml version="1.0" encoding="utf-8"?>
<com.datong.dict.widget.base.BaseScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="always"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:descendantFocusability="blocksDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:paddingLeft="@dimen/x20"
        android:paddingRight="@dimen/x20"
        android:paddingBottom="@dimen/x20">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_youdao_discriminate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x20">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_youdao_discriminate"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/x20"
                android:layout_marginBottom="@dimen/x50" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</com.datong.dict.widget.base.BaseScrollView>
