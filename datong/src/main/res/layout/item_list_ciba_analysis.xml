<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/x20"
    android:layout_marginRight="@dimen/x20"
    app:contentPaddingLeft="@dimen/x50">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:id="@+id/item_list_header"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x50" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_item_list_ciba_analysis_index"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x4"
                android:text="1."
                android:textSize="@dimen/x45"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/x30"
                android:layout_marginRight="@dimen/x60"
                android:orientation="vertical">

                <com.datong.dict.widget.WordTextView
                    android:id="@+id/tv_item_list_ciba_analysis_words"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="@dimen/x10"
                    android:text="abecome, get, grow, turn, go, come"
                    android:textColor="#000000"
                    android:textSize="@dimen/x48"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_item_list_ciba_analysis_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/x10"
                    android:lineSpacingExtra="@dimen/x10"
                    android:text="这些动词均可表示变成，成为之意。"
                    android:textSize="@dimen/x40" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list_item_list_ciba_analysis_explains"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/x5"
                    android:scrollbars="none" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/item_list_footer"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x50" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
