<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize">

    <TextView
        android:id="@+id/toolbar_menuAnchor"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginRight="@dimen/x20" />

    <ImageView
        android:id="@+id/img_toolbar_back"
        android:layout_width="@dimen/x150"
        android:layout_height="match_parent"
        android:layout_centerVertical="true"
        android:background="@drawable/item_bg_gary"
        android:clickable="true"
        android:padding="@dimen/x33"
        android:scaleType="centerInside"
        android:src="@drawable/ic_back" />

    <TextView
        android:id="@+id/tv_toolbar_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@+id/img_toolbar_back"
        android:text="Title"
        android:textSize="@dimen/x50" />

    <ImageView
        android:id="@+id/img_toolbar_action_1"
        android:layout_width="@dimen/x150"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="@dimen/x130"
        android:background="@drawable/item_bg_gary"
        android:clickable="false"
        android:padding="@dimen/y33"
        android:scaleType="centerInside" />

    <ImageView
        android:id="@+id/img_toolbar_action_2"
        android:layout_width="@dimen/x150"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:background="@drawable/item_bg_gary"
        android:clickable="false"
        android:padding="@dimen/y33"
        android:scaleType="centerInside" />
</RelativeLayout>
