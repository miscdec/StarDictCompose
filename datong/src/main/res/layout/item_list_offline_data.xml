<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x200"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true">

    <com.akexorcist.roundcornerprogressbar.RoundCornerProgressBar
        android:id="@+id/progressBar_item_list_offlineData"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:rcRadius="0dp" />

    <TextView
        android:id="@+id/tv_item_list_offline_data_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x50"
        android:layout_marginTop="@dimen/x30"
        android:textColor="#000000"
        android:textSize="@dimen/x50" />

    <TextView
        android:id="@+id/tv_item_list_offline_data_subTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_item_list_offline_data_title"
        android:layout_marginLeft="@dimen/x50"
        android:layout_marginTop="@dimen/x20"
        android:layout_marginBottom="@dimen/x30"
        android:textSize="@dimen/x38" />

    <TextView
        android:id="@+id/tv_item_list_offline_data_btn"
        android:layout_width="@dimen/x200"
        android:layout_height="@dimen/x100"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="@dimen/x20"
        android:gravity="center"
        android:text="下载"
        android:textSize="@dimen/x40" />
</RelativeLayout>
