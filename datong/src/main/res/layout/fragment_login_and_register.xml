<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.datong.dict.widget.base.BaseTabLayout
        android:id="@+id/tabLayout_login_and_register"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabTextAppearance="@style/MyTabLayoutStyle" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/pager_login_and_register"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/tabLayout_login_and_register"
        android:overScrollMode="never" />
</RelativeLayout>
