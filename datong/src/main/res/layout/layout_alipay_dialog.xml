<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/x80">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前售价 :"
            android:textColor="#000000"
            android:textSize="@dimen/x50" />

        <TextView
            android:id="@+id/tv_alipayDialog_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="￥2.99"
            android:textColor="#000000"
            android:textSize="@dimen/x100"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_alipayDialog_tips"
        android:layout_width="@dimen/x780"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/y50"
        android:lineSpacingExtra="@dimen/x15"
        android:textSize="@dimen/x45" />

    <ImageView
        android:layout_width="@dimen/x800"
        android:layout_height="@dimen/x500"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/x50"
        android:scaleType="fitCenter"
        android:src="@drawable/img_alipay_explam" />
</LinearLayout>
