<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/x40"
    android:layout_marginRight="@dimen/x40">

    <TextView
        android:id="@+id/tv_item_list_youdao_the21st_phrase_index"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1."
        android:textSize="@dimen/x45"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x30"
        android:layout_marginRight="@dimen/x50"
        android:orientation="vertical">

        <com.datong.dict.widget.WordTextView
            android:id="@+id/tv_item_list_youdao_the21st_phrase_phrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="@dimen/x10"
            android:text="in any shape(or form)"
            android:textColor="#000000"
            android:textSize="@dimen/x45" />

        <TextView
            android:id="@+id/tv_item_list_youdao_the21st_phrase_explain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x30"
            android:lineSpacingExtra="@dimen/x20"
            android:text="1.[口语]\102.无论什么形式\103.完全地，全然；根本上"
            android:textSize="@dimen/x40" />
    </LinearLayout>
</LinearLayout>
