<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/x20"
    android:layout_marginRight="@dimen/x20"
    app:contentPaddingLeft="@dimen/x50">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:id="@+id/item_list_header"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x50" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_item_list_datong_jp_sentence_index"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x8"
                android:text="1."
                android:textSize="@dimen/x45"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/x30"
                android:layout_marginRight="@dimen/x50"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tv_item_list_datong_jp_sentence_jp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginRight="@dimen/x100"
                        android:lineSpacingExtra="@dimen/x10"
                        android:text="金銭にかけてはがっちりしている。"
                        android:textColor="#000000"
                        android:textSize="@dimen/x42" />

                    <ImageView
                        android:id="@+id/img_item_list_datong_jp_sentence_sound"
                        android:layout_width="@dimen/x80"
                        android:layout_height="@dimen/x80"
                        android:layout_alignParentRight="true"
                        android:background="@drawable/item_bg_gary"
                        android:clickable="true"
                        android:padding="@dimen/x10"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_sound" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tv_item_list_datong_jp_sentence_cn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/x100"
                    android:lineSpacingExtra="@dimen/x10"
                    android:text="在用钱方面很仔细。"
                    android:textSize="@dimen/y40" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/item_list_footer"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x50" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
