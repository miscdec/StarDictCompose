<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_item_list_youdao_the21st_explain_wordClass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x20"
        android:text="v."
        android:textColor="@color/red_datong"
        android:textSize="@dimen/x50" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x40">

        <TextView
            android:id="@+id/tv_item_list_youdao_the21st_explain_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1."
            android:textSize="@dimen/x45"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x30"
            android:layout_marginRight="@dimen/x50"
            android:orientation="vertical">

            <com.datong.dict.widget.WordTextView
                android:id="@+id/tv_item_list_youdao_the21st_explain_explain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="@dimen/x10"
                android:text="惊奇，惊讶："
                android:textColor="#000000"
                android:textSize="@dimen/x45" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x30"
                android:orientation="vertical">

                <com.datong.dict.widget.WordTextView
                    android:id="@+id/tv_item_list_youdao_the21st_explain_en_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="@dimen/x10"
                    android:text="I wonder at your allowing her toLanguage buy the expensive clothes."
                    android:textSize="@dimen/x42" />

                <TextView
                    android:id="@+id/tv_item_list_youdao_the21st_explain_cn_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/x20"
                    android:lineSpacingExtra="@dimen/x10"
                    android:text="我对你答应她买这么贵的衣服感到吃惊。"
                    android:textSize="@dimen/x38" />

                <com.datong.dict.widget.WordTextView
                    android:id="@+id/tv_item_list_youdao_the21st_explain_en_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/x20"
                    android:lineSpacingExtra="@dimen/x10"
                    android:text="I wonder at your allowing her toLanguage buy the expensive clothes."
                    android:textSize="@dimen/x42" />

                <TextView
                    android:id="@+id/tv_item_list_youdao_the21st_explain_cn_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/x20"
                    android:lineSpacingExtra="@dimen/x10"
                    android:text="我对你答应她买这么贵的衣服感到吃惊。"
                    android:textSize="@dimen/x38" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
